{
  "name": "agent-content-monorepo",
  "private": true,
  "type": "module",
  "description": "Make every website readable by AI agents — developer infrastructure, content negotiation, and llms.txt generation.",
  "license": "Apache-2.0",
  "author": "IITDEVELOPER",
  "homepage": "https://github.com/iitdeveloper-git/agent-content",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iitdeveloper-git/agent-content.git"
  },
  "bugs": {
    "url": "https://github.com/iitdeveloper-git/agent-content/issues"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.18.1",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --filter \"./packages/*\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm --recursive --filter \"./packages/*\" run typecheck",
    "lint": "eslint \"packages/**/src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "pnpm --recursive run clean || rm -rf packages/*/dist"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.20.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.0.5"
  }
}
