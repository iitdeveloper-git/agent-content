{
  "name": "@iitdeveloper/agent-content-cli",
  "version": "0.1.0",
  "description": "Command-line interface for AgentContent — static site HTML to Markdown inspection, registry validation, and llms.txt generation.",
  "license": "Apache-2.0",
  "author": "IITDEVELOPER",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iitdeveloper-git/agent-content.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "agent-content": "./dist/bin.js",
    "agent-content-cli": "./dist/bin.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@iitdeveloper/agent-content": "workspace:*",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
