{
  "name": "@iitdeveloper/agent-content-nextjs",
  "version": "0.1.0",
  "description": "Next.js App Router integration adapter for AgentContent — automatic Markdown content negotiation, route handlers, and llms.txt discovery.",
  "license": "Apache-2.0",
  "author": "IITDEVELOPER",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iitdeveloper-git/agent-content.git",
    "directory": "packages/nextjs"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@iitdeveloper/agent-content": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
